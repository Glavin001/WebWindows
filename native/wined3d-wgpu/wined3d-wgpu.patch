diff -ruN a/dlls/wined3d/directx.c b/dlls/wined3d/directx.c
--- a/dlls/wined3d/directx.c	2026-10-07 19:06:14.378949413 +0000
+++ b/dlls/wined3d/directx.c	2026-10-07 19:06:14.458271432 +0000
@@ -3481,9 +3481,20 @@
 
 static struct wined3d_adapter *wined3d_adapter_create(unsigned int ordinal, DWORD wined3d_creation_flags)
 {
+    struct wined3d_adapter *adapter;
+
     if (wined3d_creation_flags & WINED3D_NO3D)
         return wined3d_adapter_no3d_create(ordinal, wined3d_creation_flags);
 
+    /* WebGPU when the host has it (the browser runtime), else as before. */
+    if (wined3d_settings.renderer == WINED3D_RENDERER_WEBGPU || wined3d_settings.renderer == WINED3D_RENDERER_AUTO)
+    {
+        if ((adapter = wined3d_adapter_wgpu_create(ordinal, wined3d_creation_flags)))
+            return adapter;
+        if (wined3d_settings.renderer == WINED3D_RENDERER_WEBGPU)
+            return wined3d_adapter_no3d_create(ordinal, wined3d_creation_flags | WINED3D_NO3D);
+    }
+
     if (wined3d_settings.renderer == WINED3D_RENDERER_VULKAN)
         return wined3d_adapter_vk_create(ordinal, wined3d_creation_flags);
 
