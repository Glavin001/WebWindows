+++ b/dlls/wined3d/buffer.c	2026-10-07 19:06:14.459436564 +0000
@@ -1053,6 +1053,24 @@
     return wined3d_buffer_init(buffer_no3d, device, desc, data, parent, parent_ops, &wined3d_buffer_no3d_ops);
 }
 
+static const struct wined3d_buffer_ops wined3d_buffer_wgpu_ops =
+{
+    wined3d_buffer_wgpu_prepare_location,
+    wined3d_buffer_wgpu_unload_location,
+};
+
+HRESULT wined3d_buffer_wgpu_init(struct wined3d_buffer *buffer, struct wined3d_device *device,
+        const struct wined3d_buffer_desc *desc, const struct wined3d_sub_resource_data *data,
+        void *parent, const struct wined3d_parent_ops *parent_ops)
+{
+    TRACE("buffer %p, device %p, desc %p, data %p, parent %p, parent_ops %p.\n",
+            buffer, device, desc, data, parent, parent_ops);
+
+    if (desc->access & WINED3D_RESOURCE_ACCESS_GPU)
+        buffer->flags |= WINED3D_BUFFER_USE_BO;
+    return wined3d_buffer_init(buffer, device, desc, data, parent, parent_ops, &wined3d_buffer_wgpu_ops);
+}
